# =============================================================
# Flask app (EVO integration)
# =============================================================

# Credenciales EVO (W12) — pedir al admin de EVO de NEO Chile
# NO comitear el .env real, solo este ejemplo.

# DNS compartido por todas las sedes de NEO Chile (mismo `neocl`)
EVO_USERNAME=neocl

# Token (password Basic Auth) por sede — cada uno apunta a un idBranch distinto
EVO_PASSWORD=token_plaza_vespucio_aqui
EVO_PASSWORD_INDEPENDENCIA=token_independencia_aqui

# Opcional: solo si EVO cambia el valor. Por default usa el mismo que neo-ws.
# EVO_NEO_HEADER=evo3jok123987k123123dY6Pq45

# =============================================================
# Bot de soporte (RAG en Supabase + OpenAI)
# =============================================================

# Supabase (Postgres + pgvector)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=

# Embeddings
EMBED_PROVIDER=openai              # openai | ollama
EMBED_MODEL=text-embedding-3-small # 1536 dims. Cambiar implica re-indexar.
OPENAI_API_KEY=

# LLM (respuesta generada)
LLM_PROVIDER=openai                # anthropic | openai | ollama
OPENAI_LLM_MODEL=gpt-4o-mini
# Si LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

# Gate 1 de out-of-scope
SIMILARITY_THRESHOLD=0.35
TOP_K=3
